# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# DSN explicite plutot que le seul dbname_suffix applique au DSN de developpement : le
# nom de la base de test cesse ainsi de dependre d'une surcharge locale de .env.local que
# la CI n'a pas. Le suffixe de config/packages/doctrine.yaml s'y ajoute quand meme, donc
# la base reellement utilisee est « proglab_skills_test » — jamais « proglab_skills ».
# Ne pas ecrire le suffixe ici : le DSN nomme la base de developpement, doctrine.yaml
# ajoute « _test ». L'ecrire deux fois donne « proglab_skills_test_test ».
DATABASE_URL="mysql://root:@127.0.0.1:3306/proglab_skills?serverVersion=8.4&charset=utf8mb4"

# Aucune connexion SMTP pendant la suite. `framework.test: true` ne neutralise pas le
# transport du mailer — il n'ajoute que le logger de messages sur lequel
# `MailerAssertionsTrait` s'appuie —, donc sans cette ligne chaque test qui envoie un
# email tenterait d'ouvrir le port 1025 de `.env` et échouerait sur un poste sans Mailpit.
#
# Rien d'équivalent pour MESSENGER_TRANSPORT_DSN : le `when@test` de
# config/packages/messenger.yaml remplace déjà le DSN des deux transports par
# `in-memory://`, en gardant leurs noms et leur routage.
MAILER_DSN=null://null
