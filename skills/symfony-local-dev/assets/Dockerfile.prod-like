# syntax=docker/dockerfile:1
#
# Local production-like verification. NOT a production Dockerfile.
#
# Its only job is to answer questions the dev server cannot: are the assets
# actually compiled, does the app boot with APP_ENV=prod, is anything relying on
# the profiler, does HTTP/2 really serve the AssetMapper files. Half an hour
# here beats finding out after a deploy.
#
# For real production, use the reference implementation rather than this file:
# https://github.com/dunglas/symfony-docker — it handles workers, healthchecks,
# non-root users, TLS and the recipe hooks, all of which are out of scope here.
#
# Keep the PHP version in step with production.
FROM dunglas/frankenphp:1-php8.4

WORKDIR /app

RUN install-php-extensions @composer intl opcache zip pdo_pgsql apcu

ENV APP_ENV=prod
ENV APP_DEBUG=0
ENV COMPOSER_ALLOW_SUPERUSER=1

# Production php.ini: OPcache on, timestamp validation off, errors hidden.
# This alone catches code that only worked because dev was forgiving.
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# Dependencies first, so editing source does not reinstall vendors.
COPY composer.json composer.lock symfony.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-progress

COPY . .

RUN set -eux; \
    mkdir -p var/cache var/log; \
    composer dump-autoload --classmap-authoritative --no-dev; \
    composer run-script --no-dev post-install-cmd; \
    # The step everyone forgets. Without it Symfony serves every asset through
    # PHP at runtime, and people conclude AssetMapper is slow.
    php bin/console asset-map:compile

# `frankenphp run`, not `php-server`. The image's bundled Caddyfile reads
# SERVER_NAME — set to `localhost` in compose.prod-like.yaml — issues a local
# certificate for it, and serves HTTP/2 and HTTP/3. That is the entire point of
# this check: AssetMapper over HTTP/1.1 is slower than a bundle, so verifying it
# on HTTP/1.1 verifies the wrong thing.
#
# `frankenphp php-server --root public/ --listen :80` serves cleartext HTTP/1.1
# and ignores SERVER_NAME, which leaves nothing listening on https://localhost.
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
