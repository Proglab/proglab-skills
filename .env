# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
#
# MySQL 8.4 LTS est le plancher contractuel du socle, et serverVersion le dit ici comme
# dans .env.test et dans le workflow de CI : MySQL 8.0 est en fin de vie depuis avril
# 2026 et ne tient pas la fenetre de Symfony 7.4 LTS. Les exemples SQLite et MariaDB de
# la recette ont ete retires — un socle qui teste sur un autre moteur que la production
# fait apparaitre les differences chez le client.
# tests/Core/Quality/TestDatabaseEngineTest.php tient cette coherence.
DATABASE_URL="mysql://root:@127.0.0.1:3306/proglab_skills?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> app ###
# Le nom du dérivé, tel qu'il apparaît dans le `<title>` de chaque page
# (« Accueil — Menuiserie Dubois »). C'est une variable d'environnement et non un réglage
# en base ou en administration : le rebranding d'un dérivé se fait au clonage, pas depuis
# l'application, et un dérivé qui se renomme ne touche aucun fichier de `src/` ni de
# `config/`. Chemin complet : APP_NAME → paramètre `app.name` → global Twig `app_name`.
APP_NAME="Socle ERP"
###< app ###

###> symfony/messenger ###
# Où vit la file des emails. `doctrine://default` désigne la connexion DBAL de
# l'application elle-même — pas un second magasin : la file est sauvegardée et restaurée
# avec la base métier, et ce qui attend se lit au `SELECT`.
#
# C'est aussi ce qui tient le critère central de la story 1.8 (AD-21, décision D-1) : le
# transport écrit sur la connexion de l'application, donc un message dispatché à
# l'intérieur d'une transaction n'est visible qu'au commit de celle-ci.
# tests/Core/Mail/EmailQueueTest.php le vérifie depuis une seconde connexion.
#
# `auto_setup=0` interdit tout DDL à l'exécution : la table `messenger_messages` vient
# d'une migration relue. config/packages/messenger.yaml le réécrit en `auto_setup: false`
# pour qu'un dérivé qui surcharge cette variable ne rouvre pas la porte.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Mailpit en développement, sur le port SMTP que Laragon comme le binaire autonome
# exposent par défaut. Aucun routage `sync` n'est posé en `when@dev` : le développement
# exerce exactement le chemin de production — la file, le retry et la file d'échec
# comprise —, donc **il faut un worker pour voir un email arriver** (`make worker`, et la
# section « Le worker » du README).
#
# La production surcharge cette valeur par le SMTP du serveur client, hors dépôt
# (`.env.local` ou `composer dump-env prod`).
#
# En test, `.env.test` met `null://null` : la suite n'ouvre aucune connexion SMTP, et
# `tests/Core/Mail/SendEmailHandlerTest.php` lit les messages sur le logger du mailer.
MAILER_DSN=smtp://127.0.0.1:1025

# L'adresse qui apparaît en expéditeur de chaque email du socle.
#
# Elle existe parce qu'un message sans en-tête `From` n'est pas envoyable du tout
# (`Symfony\Component\Mime\Message` lève « An email must have a "From" or a "Sender"
# header »). `config/packages/mailer.yaml` la pose une fois pour tous les emails, donc
# aucun service n'a à s'en souvenir, et un dérivé la change sans éditer `src/` ni
# `config/` — comme APP_NAME.
#
# La valeur par défaut est volontairement inutilisable en production : un serveur client
# refusera de relayer un domaine qu'il ne connaît pas, et c'est préférable à un email qui
# part au nom de quelqu'un d'autre.
MAILER_SENDER=no-reply@localhost
###< symfony/mailer ###
