<?xml version="1.0" encoding="UTF-8"?>

<!-- Copier à la racine du projet en tant que phpunit.dist.xml.

     C'est le fichier de la recette Symfony avec deux ajouts que la recette ne
     fournit pas : failOnPhpunitNotice, et l'extension DAMA qui isole les tests
     de base de données. Les deux sont expliqués dans assets/README.md. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         failOnPhpunitNotice="true"
         displayDetailsOnPhpunitNotices="true"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <!-- Isolation de la base de données. Cette ligne seule ne suffit pas : le
         bundle doit aussi être dans config/bundles.php sous 'test', sinon
         l'extension s'exécute, ne trouve aucune connexion statique à
         envelopper, et chaque test valide (commit) — vert, et qui fuit.
         Supprimer tout le bloc sur un projet sans Doctrine. -->
    <extensions>
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
    </extensions>
</phpunit>
