# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# GNU make exige des tabulations : un editeur qui applique `indent_style = space`
# ci-dessus casse le Makefile avec « missing separator ».
[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2
